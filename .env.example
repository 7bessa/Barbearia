# Copie para .env.local (ou rode "npm run setup" para gerar com valores aleatórios) e troque TODOS os valores.
# Gere o segredo com: openssl rand -base64 48  (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres

# Senhas iniciais dos usuários de seed (guardadas apenas como hash bcrypt, mínimo 8 caracteres)
SEED_ADMIN_PASSWORD=troque-senha-admin
SEED_BARBEIRO_PASSWORD=troque-senha-barbeiro
SEED_CLIENTE_PASSWORD=troque-senha-cliente

# Banco PostgreSQL. Senha com caracteres especiais precisa de %-encoding (@ vira %40, # vira %23).
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/barbearia?schema=public

# Produção: e-mail e telefone do dono (admin) criado pelo seed; SEED_ADMIN_PASSWORD é obrigatória.
# SEED_ADMIN_EMAIL=dono@seusite.com.br
# SEED_ADMIN_TELEFONE=62999990003

# URL pública do site (checagem de Origin/CSRF). OBRIGATÓRIO em produção, ex.: https://seusite.com.br
APP_ORIGIN=http://localhost:3000

# Produção: 1 somente se o app roda atrás de proxy/CDN que reescreve x-forwarded-for (Vercel, Cloudflare, Nginx).
# Com 0, o IP vem da conexão; com 1 sem proxy confiável, o rate limit pode ser burlado.
TRUST_PROXY=0

# Segurança do SaaS: em produção, o cadastro público de novas barbearias começa bloqueado.
# Só use 1 depois de configurar confirmação de e-mail e proteção antiabuso.
# ONBOARDING_PUBLICO=1

# Barbeiros entram por convite: o dono gera o código no painel (POST /api/admin/convites). Não há mais código fixo.
